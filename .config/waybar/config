{
  "layer": "top",
  "modules-left": ["ext/workspaces"],
  "modules-center": [""],
  "modules-right": [
    "memory",
    "cpu",	  
    "wireplumber",
    "clock"
  ],
  "clock": {
    "format-alt": "{:%a, %d. %b %H:%M:%S}"
  },
  "ext/workspaces": {
    "format": "{name}",
    "sort-by-id": true,
    "ignore-hidden": false,
    "all-outputs": false,
    "active-only": false,
    "on-click": "activate"
  },

  "dwl/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 16,
    "swap-icon-label": false,
    "max-length": 70,
    "expand": true,
    "tooltip": false,
    "rewrite": {
      "^$": "Workspace Overview"
    }
  },
  "cpu": {
    "format": "󰍛 {usage:>2}%",
    "tooltip": false
  },
  "memory": {
    "format": "Ram:{}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  "wireplumber": {
    "format": "󰕾 {volume:>2}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{node_name} {volume}%"
  }
}
